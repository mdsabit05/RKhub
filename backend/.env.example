PORT=8787
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/rkhub
CORS_ORIGIN=http://localhost:5173

# Admin Security Key
ADMIN_SECRET_KEY=rkhub-admin-2026

# AI LLM Provider Configuration (NVIDIA NIM / OpenAI-compatible / Gemini)
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: Google Gemini API Key
# GEMINI_API_KEY=your_gemini_api_key_here

# Storage Provider: "local" (default) or "s3" / "r2" / "supabase"
STORAGE_PROVIDER=local
# S3_ENDPOINT=https://...
# S3_BUCKET=rkhub-pdfs
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_PUBLIC_DOMAIN=https://cdn.example.com
